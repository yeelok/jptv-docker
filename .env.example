# Copy to .env to customise your local `docker compose` invocation.
#
# NVIDIA GPU hardware transcoding (NVEncC): uncomment the line below so every
# `docker compose ...` command automatically layers the GPU override on top of
# the base stack. Also set `encoder: 'NVEncC'` in KonomiTV/config.yaml.
# (Requires the NVIDIA driver + NVIDIA Container Toolkit on the host.)
#
# COMPOSE_FILE=docker-compose.yaml:docker-compose.nvidia.yaml
