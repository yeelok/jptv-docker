# Recorded / captured media (runtime output)
/recordings/
/capture/
*.ts

# EDCB Setting/: track only the ChSet channel definitions (config);
# ignore runtime data (gathered EPG, reservations, logs) that churns constantly.
/edcb/conf/Setting/*
!/edcb/conf/Setting/.gitkeep
!/edcb/conf/Setting/*ChSet4.txt
!/edcb/conf/Setting/ChSet5.txt

# Local compose env (e.g. COMPOSE_FILE for the NVIDIA override); .env.example is tracked
/.env

# Claude Code local settings
/.claude/

# OS / editor cruft
.DS_Store

# Watchdog maintenance switch (see README "Surviving a host reboot")
.watchdog-disabled
